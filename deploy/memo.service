[Unit]
Description=M.E.M.O. wall terminal (PCD-0451)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=memo
Group=memo
SupplementaryGroups=audio gpio i2c spi dialout
WorkingDirectory=/opt/memo
EnvironmentFile=/etc/memo.env
ExecStart=/opt/memo/venv/bin/python -m memo.main
Restart=on-failure
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
